[Unit]
Description=Agent Multi-Device Sync Receiver
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=agent-sync
Group=agent-sync
WorkingDirectory=/var/lib/agent-sync
ExecStart=/usr/bin/python3 /opt/agent-sync/receiver.py --config /etc/agent-sync/receiver.json
Restart=on-failure
RestartSec=5

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-sync
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
